# ---- 必須 ----
# スプレッドシート URL の /spreadsheets/d/<ここ>/edit
SPREADSHEET_ID=1J312hSawdBlyyFfQYEWkK7siatN2f7zulwkWBKz1fhI

# 担当者名（「担当者」列の表記）: 送信元アドレス
# 各アドレスは、認証したアカウントの Gmail 設定
#   「設定 → アカウント → 他のメールアドレスを追加」
# で確認済みエイリアスとして登録されている必要があります（旧 .gs と同じ前提）。
OWNER_EMAIL_MAP=新田:sakaguchi.saiyou@gmail.com,大津:bangtangsaiyo695@gmail.com,針山:seiyaquad202510@gmail.com

# 認証（どちらか一方）
# (A) OAuth: エイリアスを登録済みのアカウントで npm run authorize して取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# (B) サービスアカウント + ドメイン全体の委任（Workspace ドメインのアドレスのみ）
#     ※ @gmail.com のアドレスには使えません
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ---- 任意（既定値を記載）----
# 走査するシートの gid。空なら該当列を持つ全シート。URL の #gid=... の値。
TARGET_SHEET_IDS=1972955214

# 担当者列が空欄の行の差出人。未設定なら空欄行は送信されません。
DEFAULT_SENDER_ADDRESS=

# true にすると OWNER_EMAIL_MAP に無い担当者も DEFAULT_SENDER_ADDRESS から送ります。
# 既定 false（誤った差出人で送るより送らない方が安全なため）。
FALLBACK_TO_DEFAULT_SENDER=false

# From の表示名は「担当者名（この値）」。空にすると担当者名のみ。
SENDER_NAME_SUFFIX=

# 全リマインドの BCC 先（カンマ区切り）
BCC_ADDRESSES=

# 1 = 翌日の面接をリマインド（旧 .gs と同じ）。0 = 当日。
REMIND_OFFSET_DAYS=1

# 「リマインド可否」列の扱い（旧 .gs と同じ requireMarked が既定）
REMIND_FLAG_MODE=requireMarked
REMIND_FLAG_ALLOW_VALUES=実施,可,TRUE

# 「リマインド可否」は担当者が入力する承認列なので書き戻しません。
WRITE_BACK_REMIND_FLAG=false

# 「面接詳細」がこの文字列で始まる行は送信済みとみなす（旧 .gs のマーカーと互換）。
# 空にするとこの判定を無効化。
SENT_MARKER_PREFIX=送信済
# 送信後に「面接詳細」の先頭へ「送信済 yyyy/MM/dd HH:mm」を追記する（既存内容は保持）。
WRITE_SENT_MARKER=true

# 送信前に From が確認済みエイリアスかを検査する。旧 .gs はここで全行を
# 無言スキップしていたため、本実装では理由をログに出し実行を失敗扱いにします。
VERIFY_SEND_AS_ALIASES=true

# 「面接設定可否」がこの値の行のみ対象。空にするとこの条件を無効化。
# 旧 .gs はこの列を見ていなかったため、同じ挙動にするなら空にしてください。
INTERVIEW_SCHEDULED_VALUES=設定済み

# 送信済み記録用の非表示シート。重複送信の防止はここが担保します。
LOG_SHEET_TITLE=_reminder_log

# 1回の実行でこの数を超えたら、1通も送らず中止します。
MAX_SENDS_PER_RUN=50

# 送信は明示的なオプトイン。DRY RUN で確認するまで true のままに。
DRY_RUN=true
