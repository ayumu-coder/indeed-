# ---- Required ----
# From the spreadsheet URL: /spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1J312hSawdBlyyFfQYEWkK7siatN2f7zulwkWBKz1fhI
# The Gmail account that sends the mail. Must be the account authorised by `npm run authorize`.
SENDER_ADDRESS=you@quad-4.co.jp

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Optional (defaults shown) ----
# Sheet gids to scan, comma separated. Empty = every sheet with a recognisable header row.
# The gid is the #gid=... fragment in the sheet URL.
TARGET_SHEET_IDS=1972955214

# Display name on the From header.
SENDER_NAME=株式会社Quad

# Copy every reminder to these addresses, comma separated.
BCC_ADDRESSES=

# 1 = remind about tomorrow's interviews. 0 = today's.
REMIND_OFFSET_DAYS=1

# How the リマインド可否 column gates a row:
#   skipIfMarked  - a non-empty cell means "already handled", skip it (default, safest)
#   requireMarked - only send rows whose cell is in REMIND_FLAG_ALLOW_VALUES
#   ignore        - do not consult the column
REMIND_FLAG_MODE=skipIfMarked
REMIND_FLAG_ALLOW_VALUES=実施,可,TRUE
REMIND_FLAG_WRITE_VALUE=実施
WRITE_BACK_REMIND_FLAG=true

# Values of 面接設定可否 that count as "booked". Set empty to disable this gate.
INTERVIEW_SCHEDULED_VALUES=設定済み

# Hidden sheet that records what was sent, so a re-run cannot double-send.
LOG_SHEET_TITLE=_reminder_log

# Abort the whole run rather than send more than this in one go.
MAX_SENDS_PER_RUN=50

# Sending is opt-in. Leave true until a dry run looks right.
DRY_RUN=true

# =====================================================================
# LINE forwarder (npm run forward) — 特定の差出人からのメールを LINE へ転送
# =====================================================================

# Addresses to watch, comma separated. Compared exactly against the From address.
WATCH_SENDERS=y.shirai@linkup-c3.jp

# LINE Messaging API channel access token (long-lived) of the Official Account.
LINE_CHANNEL_ACCESS_TOKEN=

# Destination: userId (U...), groupId (C...) or roomId (R...). 33 chars.
LINE_TO=

# Checked by `npm run line:verify` only — never used at runtime.
LINE_EXPECTED_DISPLAY_NAME=稲垣 広斗

# ---- Optional (defaults shown) ----
# Gmail label applied after a successful push. This label IS the dedupe store.
FORWARDED_LABEL=LINE転送済み

# How far back each run looks. Bounds a first run and a long outage.
FORWARD_LOOKBACK_MINUTES=1440

# Characters of the mail body included in the LINE message.
BODY_MAX_CHARS=700

# Abort the run rather than push more than this at once.
MAX_PUSHES_PER_RUN=20

# Append a deep link to the Gmail thread. GMAIL_USER_INDEX is the u/<n> segment.
INCLUDE_GMAIL_LINK=true
GMAIL_USER_INDEX=0

# Pushing is opt-in, same as the reminder job.
DRY_RUN=true

# =====================================================================
# ショート動画ジェネレーター (npm run video:render)
# 動画の書き出しにのみ使う。リマインド送信・LINE 転送には一切影響しない。
# =====================================================================

# auto (既定) = VOICEVOX -> Open JTalk -> 無音 の順で自動選択
# voicevox / openjtalk / none を明示指定できる
TTS_ENGINE=auto

# VOICEVOX ENGINE を使う場合。設定すると VOICEVOX が優先される。
VOICEVOX_URL=
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.15

# Open JTalk を使う場合。辞書と音声ファイルは未指定なら自動検出する。
OPENJTALK_BIN=open_jtalk
OPENJTALK_DIC=
OPENJTALK_VOICE=
OPENJTALK_RATE=1.8

# BGM を重ねる場合。素材のライセンスは利用者が担保すること。
BGM_PATH=
BGM_GAIN_DB=-22

# ffmpeg を差し替える場合 (既定は ffmpeg-static)
FFMPEG_PATH=

# ---------------------------------------------------------------------
# Instagram リール自動投稿 (npm run video:publish)
# 送信は DRY_RUN=false のときだけ行う。既定はドライラン。
# ---------------------------------------------------------------------

# 動画の一時置き場。S3 互換ならどれでもよい (AWS S3 / Cloudflare R2 / MinIO)。
# バケットは公開しない。Instagram には期限付きのプリサイン URL を渡す。
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=shorts
# R2 はリージョンを持たないので auto。AWS S3 なら ap-northeast-1 など。
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 / MinIO は true のまま。AWS S3 は false でもよい。
S3_PATH_STYLE=true
# プリサイン URL の有効期限 (秒)。Instagram の取得が終わるまで持てばよい。
MEDIA_URL_TTL_SECONDS=3600

# Instagram プロアカウント (ビジネス/クリエイター) の ID と長期アクセストークン。
IG_USER_ID=
IG_ACCESS_TOKEN=
# Graph API のバージョン。上げるときは changelog を確認してから。
IG_GRAPH_VERSION=v24.0
IG_POLL_INTERVAL_MS=5000
IG_POLL_TIMEOUT_MS=300000
# リールをフィードにも表示するか。
IG_SHARE_TO_FEED=true
