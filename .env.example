# ---- 必須 ----
# スプレッドシート URL の /spreadsheets/d/<ここ>/edit
SPREADSHEET_ID=1J312hSawdBlyyFfQYEWkK7siatN2f7zulwkWBKz1fhI

# サービスアカウントの JSON キー全文（1行）。
# ドメイン全体の委任を設定すると、担当者ごとの差出人で送信できます。
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}

# 担当者名（スプレッドシートの「担当者」列の表記）: 送信元アドレス
# ここに無い担当者の行は送信されず、実行が失敗扱いになります（誤った差出人で送らないため）。
OWNER_EMAIL_MAP=新田:nitta@quad-4.co.jp,針山:hariyama@quad-4.co.jp,大津:otsu@quad-4.co.jp

# ---- 任意（既定値を記載）----
# 走査するシートの gid。空なら該当列を持つ全シート。URL の #gid=... の値。
TARGET_SHEET_IDS=1972955214

# 担当者列が空欄の行の差出人。未設定なら空欄行は送信されません。
DEFAULT_SENDER_ADDRESS=

# true にすると、OWNER_EMAIL_MAP に無い担当者も DEFAULT_SENDER_ADDRESS から送ります。
# 既定は false（誤った差出人で送るより、送らない方が安全なため）。
FALLBACK_TO_DEFAULT_SENDER=false

# From ヘッダーの表示名は「担当者名（この値）」になります。例: 新田（株式会社Quad）
SENDER_NAME_SUFFIX=株式会社Quad

# 全リマインドの BCC 先（カンマ区切り）
BCC_ADDRESSES=

# 1 = 翌日の面接をリマインド。0 = 当日。
REMIND_OFFSET_DAYS=1

# 「リマインド可否」列の扱い:
#   requireMarked - 「実施」等が入っている行だけ送る（既定・現在の運用に合わせた設定）
#   skipIfMarked  - 値が入っていたら送信済みとみなしてスキップ
#   ignore        - この列を見ない
REMIND_FLAG_MODE=requireMarked
REMIND_FLAG_ALLOW_VALUES=実施,可,TRUE

# 「リマインド可否」は担当者が入力する承認フラグなので、既定では書き戻しません。
WRITE_BACK_REMIND_FLAG=false
REMIND_FLAG_WRITE_VALUE=実施

# 「面接設定可否」がこの値の行のみ対象。空にするとこの条件を無効化。
INTERVIEW_SCHEDULED_VALUES=設定済み

# 送信済み記録用の非表示シート。重複送信の防止はここが担保します。
LOG_SHEET_TITLE=_reminder_log

# 1回の実行でこの数を超えたら、1通も送らず中止します。
MAX_SENDS_PER_RUN=50

# 送信は明示的なオプトイン。DRY RUN で確認するまで true のままにしてください。
DRY_RUN=true
